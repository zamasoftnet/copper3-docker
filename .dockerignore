# ビルドコンテキストから除外（イメージに焼かない）
.git
.github
.gitignore
.dockerignore
README.md
*.md
deploy
deploy.sh

# 秘密は絶対にイメージへ入れない（ローカルに存在しても除外）
conf/license-key
conf/password.txt
deploy.json
user/

# 通常のbuild contextへフォントを入れない。配布用はNotoの2ディレクトリ、
# 内部用はフルpackを、それぞれ明示したnamed contextからだけ取り込む。
conf/profiles/fonts/

# ログ・一時
*.log
*.tmp
